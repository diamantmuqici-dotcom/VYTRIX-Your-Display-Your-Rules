# VYTRIX API configuration. Copy to .env and fill in real values.
# Every optional block is feature-gated: leave values blank to disable that feature.

# --- Core (required) -------------------------------------------------------
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://vytrix:vytrix@localhost:5432/vytrix
# 32+ random bytes. Generate: openssl rand -base64 32
JWT_SECRET=replace-with-a-32-byte-random-secret
# 16+ random bytes, separate from JWT_SECRET. Machine ids are SHA-256 hashed with this pepper.
MACHINE_ID_PEPPER=replace-with-a-different-16-byte-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173

# --- Releases / signed update manifests ------------------------------------
# Ed25519 SPKI public key in PEM form (single line with \n escapes, or a real multi-line PEM).
# When blank, POST /releases is disabled. Generate: openssl genpkey -algorithm ed25519 -out release.key
RELEASE_SIGNING_PUBLIC_KEY=
# Static CI token accepted as a Bearer credential by POST /releases.
# When blank, ADMIN role on a JWT is required instead.
ADMIN_RELEASE_TOKEN=

# --- Stripe billing (disabled when STRIPE_SECRET_KEY is blank) -------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# --- Discord OAuth2 scaffolding (disabled unless all three are set) --------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# --- S3-compatible object storage (falls back to local disk when incomplete)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=./.storage

# --- Telemetry -------------------------------------------------------------
TELEMETRY_ENABLED=true
